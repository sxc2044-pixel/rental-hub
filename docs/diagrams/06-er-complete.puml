@startuml
!pragma layout smetana
skinparam defaultFontName Microsoft YaHei
skinparam monochrome true
skinparam shadowing false
entity t_user {
 * id : BIGINT <<PK>>
 --
 account : VARCHAR(32) <<UK>>
 password_hash : VARCHAR(100)
 recovery_hash : VARCHAR(100)
 role : VARCHAR(16)
 certification : VARCHAR(16)
 session_version : INT
}
entity t_house {
 * id : BIGINT <<PK>>
 --
 title : VARCHAR(100)
 region layout : VARCHAR(40)
 rent : DECIMAL(10,2)
 area : DECIMAL(8,2)
 status : VARCHAR(16)
 reviewer_id : BIGINT <<FK>>
}
entity t_reservation {
 * id : BIGINT <<PK>>
 --
 user_id house_id : BIGINT <<FK>>
 visit_time : TIMESTAMP
 active_slot : VARCHAR(80) <<UK nullable>>
 status : VARCHAR(16)
}
entity t_contract {
 * id : BIGINT <<PK>>
 --
 user_id house_id : BIGINT <<FK>>
 rent : DECIMAL(10,2)
 start_date end_date : DATE
 status : VARCHAR(16)
}
entity t_comment {
 * id : BIGINT <<PK>>
 --
 user_id house_id : BIGINT <<FK UK pair>>
 rating : INT
 content : VARCHAR(1000)
 status : VARCHAR(16)
}
entity t_favorite {
 * user_id : BIGINT <<PK FK>>
 * house_id : BIGINT <<PK FK>>
}
entity t_message {
 * id : BIGINT <<PK>>
 --
 user_id house_id : BIGINT <<FK>>
 content reply : VARCHAR(1000)
 replied_by : BIGINT <<FK>>
}
entity t_notice {
 * id : BIGINT <<PK>>
 --
 publisher_id : BIGINT <<FK>>
 title : VARCHAR(100)
 content : VARCHAR(2000)
}
entity t_dictionary {
 * id : BIGINT <<PK>>
 --
 category label : VARCHAR <<UK pair>>
 min_value max_value : DECIMAL(10,2)
}
entity t_audit {
 * id : BIGINT <<PK>>
 --
 actor_id : BIGINT <<FK>>
 action entity_type : VARCHAR
 entity_id : BIGINT
}
t_user ||--o{ t_reservation
t_house ||--o{ t_reservation
t_user ||--o{ t_contract
t_house ||--o{ t_contract
t_user ||--o{ t_comment
t_house ||--o{ t_comment
t_user ||--o{ t_favorite
t_house ||--o{ t_favorite
t_user ||--o{ t_message
t_house ||--o{ t_message
t_user ||--o{ t_notice
t_user ||--o{ t_audit
t_user |o--o{ t_house : 审核
@enduml
